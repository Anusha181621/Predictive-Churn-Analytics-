# Fashion Churn Platform - example configuration
#
# Copy to `.env` and edit as needed. Every setting below has the same value as the built-in
# default, so the project runs correctly with no `.env` file at all.
#
# IMPORTANT: all paths are RELATIVE to the project root (the directory holding this file).
# Absolute paths are never required, which is what lets the project be moved to another
# machine unchanged. Absolute paths are still accepted if you really want them.

# --- CSV data location (the source of truth; there is no database) -----------------
DATA_DIR=data
CUSTOMER_FILE=Customer.csv
TRANSACTION_FILE=Transaction.csv
RETURN_FILE=Return.csv
PRODUCT_FILE=Product.csv

# --- output locations -------------------------------------------------------------
MODELS_DIR=models
OUTPUTS_DIR=outputs
LOG_DIR=logs

# --- logging ----------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- churn definition (used from the next implementation step onwards) ------------
# Default inactivity window, in days, after a customer's last purchase.
CHURN_INACTIVITY_DAYS=180
# Prediction "as of" date, YYYY-MM-DD. Leave blank to derive it from the data as the
# maximum Purchase Date in Transaction.csv (currently 2025-12-31).
AS_OF_DATE=

# --- churn risk bands (churn probability cut-offs) --------------------------------
# Low < MEDIUM <= Medium < HIGH <= High < CRITICAL <= Critical
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_CRITICAL=0.90

# --- reproducibility & presentation ----------------------------------------------
RANDOM_SEED=42
# The dataset is denominated in euro.
CURRENCY=EUR
